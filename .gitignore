# Dependencies
node_modules/
*/node_modules/

# Production builds
client/build/
server/dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# Ignore all env variants in server and client (but keep examples)
server/.env*
client/.env*
!.env.example
!server/.env.example
!client/.env.example
server/.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

# Nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Uploads
uploads/
server/uploads/

# Temporary files
tmp/
temp/


# Seeder scripts that may contain or set credentials
server/seeders/createAdmin.js
server/seeders/resetAdminPassword.js
server/seeders/seedData.js
server/seeders/seed.js

# Local testing helpers that may contain secrets
server/test-env.js

# Ignore admin build artifacts (committed by mistake)
apps/admin/build/
# Ignore admin public index (static HTML that should not be tracked)
apps/admin/public/index.html

# Ignore client-next build artifacts and OpenNext cache
apps/client-next/.next/
apps/client-next/.open-next/
**/.open-next/
.open-next

# Ignore admin build artifacts
apps/admin/build/
