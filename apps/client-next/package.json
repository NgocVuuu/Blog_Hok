{
  "name": "client-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "sync:assets": "node ./scripts/syncAssets.js",
    "build": "next build --webpack",
    "build:cloudflare": "next build --webpack && node ./scripts/cleanCache.js",
    "postbuild": "node ./scripts/cleanCache.js",
