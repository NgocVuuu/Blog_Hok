# Enforce LF line endings for text files
* text=auto eol=lf

# Common text types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.env.example text eol=lf

# Treat binaries correctly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.mp4 binary
*.webm binary
*.ogg binary
*.zip binary
*.gz binary
*.lottie binary

